# Server-side only. Never prefix these with VITE_ and never commit real values.
# Set them as secrets/environment variables on your host (see SETUP-EMAIL.md).

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sending address. Use your own domain once verified in Resend.
# For first tests you can leave this unset (falls back to onboarding@resend.dev).
MAIL_FROM="Vendora <notifications@yourdomain.com>"

# Shown in the email footer
MAIL_SUPPORT_EMAIL=support@yourdomain.com

# Public URL of the deployed app, used to build links inside emails (no trailing slash)
APP_URL=https://yourdomain.com

# Random secret (min 24 chars) used to sign invitation links. Generate with: openssl rand -hex 32
INVITE_SIGNING_SECRET=

# Resend webhook signing secret (starts with whsec_), from Resend -> Webhooks
RESEND_WEBHOOK_SECRET=
